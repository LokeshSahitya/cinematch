# CineMatch — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
ALLOWED_ORIGINS=http://localhost:3000

# ML model configuration
CONTENT_WEIGHT=0.4              # Weight for content-based model (0-1)
COLLAB_WEIGHT=0.6               # Weight for collaborative filtering (0-1)
SVD_N_FACTORS=100               # Number of latent factors for SVD
SVD_N_EPOCHS=20                 # Training epochs

# Optional: TMDB API key for live poster fetching
# TMDB_API_KEY=your_key_here

# ── Frontend (prefix with VITE_ to expose to browser) ────────────────────────
VITE_API_URL=http://localhost:8000/api
